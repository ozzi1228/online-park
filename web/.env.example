# 복사해서 .env.local 로 사용
DATABASE_URL=postgres://sakura:sakura@localhost:5433/sakura

# openssl rand -base64 32 등으로 생성
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# 비워두면 해당 로그인 버튼이 숨겨짐
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 실시간 서버 입장권 서명 (realtime/.env 와 같은 값)
REALTIME_SECRET=
NEXT_PUBLIC_REALTIME_URL=ws://localhost:2567
