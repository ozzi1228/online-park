# 운영 비밀값 (VM의 ~/sakura.env 에만 있음. azure-create.sh가 처음 만들어 줌. 레포에 올리지 말 것)
SITE_HOST=                 # 예: sakura-park.koreacentral.cloudapp.azure.com
DATABASE_URL=              # Azure Database for PostgreSQL 접속 주소 (sslmode=require)
BETTER_AUTH_SECRET=
REALTIME_SECRET=
ADMIN_PASSWORD=
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 소셜 로그인 (키가 있을 때만 켜짐)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# (선택) VM 안의 Postgres를 쓸 때 비밀번호
LOCALDB_PASSWORD=
